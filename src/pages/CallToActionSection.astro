---
const allPosts = await Astro.glob('../posts/*.md');
// Posts tagged for CTA section
const ctaPosts = allPosts
  .filter(p => p.frontmatter.cta)
  .sort((a, b) => new Date(b.frontmatter.publishDate) - new Date(a.frontmatter.publishDate))
  .slice(0, 4);
---
<section class="w-full max-w-[1200px] mx-auto my-16">
  <!-- Section Header -->
  <hr class="border-[#d9d9d9] mb-4" />
  <div class="flex items-center pt-4 pb-6">
    <div class="w-3 h-3 bg-[#006aff] rounded-sm mr-4"></div>
    <span class="font-medium text-[11.6px] tracking-[1.80px] leading-[22px]">POST TITLE - FEATURE SECTION 2</span>
    <a href="/category/cta" class="ml-3 font-medium text-xs text-[#006aff] tracking-[1.80px] leading-[22px]">VIEW ALL</a>
  </div>

  <div class="text-center mb-12">
    <p class="text-[19.2px] leading-8">
      Fresh product updates and insights from the Square team.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {ctaPosts.map(post => (
      <article key={post.url} class="border-none shadow-none">
        <a href={post.url} class="block mb-4">
          <img src={post.frontmatter.image} alt={post.frontmatter.title} class="w-full rounded-2xl object-cover" style="height: 179px;" />
        </a>
        <span class="inline-block bg-[#c9e8f5] text-[#121212] rounded px-2 py-1 text-[10.8px] tracking-[1.20px] font-medium">
          {post.frontmatter.category.toUpperCase()}
        </span>
        <h3 class="mt-4 text-[21px] leading-[30px] font-medium">
          <a href={post.url}>{post.frontmatter.title}</a>
        </h3>
        <div class="mt-4 text-[10.7px] tracking-[1.20px] leading-[18px]">
          <time class="font-medium text-neutral-500">
            {new Date(post.frontmatter.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          {' — '}
          <span class="text-[#121212]">{post.frontmatter.readTime}</span>
        </div>
      </article>
    ))}
  </div>
</section>
