---
const allPosts = await Astro.glob('../posts/*.md');
// First post for dynamic intro
const introPost = allPosts.find(p => p.frontmatter.dynamicIntro) || {};
// Next three for list
const listPosts = allPosts
  .filter(p => p.frontmatter.dynamic)
  .sort((a, b) => new Date(b.frontmatter.publishDate) - new Date(a.frontmatter.publishDate))
  .slice(0, 3);
---
<section class="w-full max-w-[1200px] mx-auto py-16">
  <!-- Header -->
  <hr class="border-[#d9d9d9] mb-4" />
  <div class="relative">
    <div class="w-3 h-3 bg-[#006aff] rounded-sm absolute top-5"></div>
    <span class="inline-block ml-[18px] mt-[17px] font-medium text-[11.2px] tracking-[1.80px] leading-[22px]">POST TITLE - FEATURE SECTION 3</span>
  </div>

  <!-- Intro Text -->
  <div class="max-w-[584px] mx-auto mt-[87px] mb-16 text-center">
    <p class="text-[18.9px] leading-8">
      { introPost.frontmatter.excerpt }
    </p>
  </div>

  <!-- Featured Article -->
  { introPost.frontmatter.image && (
    <div class="flex gap-12 mb-24">
      <div class="flex-1">
        <img src={introPost.frontmatter.image} alt={introPost.frontmatter.title} class="w-full rounded-2xl object-cover" style="height: 434px;" />
      </div>
      <div class="flex-1">
        <span class="inline-block bg-transparent border border-[#b3b3b3] rounded-[144px] px-[9px] py-[5px] font-medium text-[#121212] text-[10.7px] tracking-[1.20px]">
          {introPost.frontmatter.category.toUpperCase()}
        </span>
        <h2 class="mt-10 text-[44.2px] leading-[54px] font-medium text-[#121212]">
          {introPost.frontmatter.title}
        </h2>
        <div class="mt-4 text-[10.8px] text-neutral-500 tracking-[1.20px] leading-[18px]">
          <time>{new Date(introPost.frontmatter.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time> — <span class="text-[#121212]">{introPost.frontmatter.readTime}</span>
        </div>
        <p class="mt-16 text-[15.2px] leading-6 text-black">
          {introPost.frontmatter.description}
        </p>
      </div>
    </div>
  ) }

  <!-- List Articles -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
    { listPosts.map(post => (
      <article key={post.url} class="flex flex-col mb-8 ${post !== listPosts[listPosts.length - 1] ? 'border-b border-[#d9d9d9] pb-8' : ''}">
        <span class="inline-block bg-[#c9e8f5] text-[#121212] rounded px-2 py-1 text-[10.7px] tracking-[1.20px] font-medium">
          {post.frontmatter.category}
        </span>
        { post.frontmatter.subtitle && (
          <span class="block mt-4 text-[21px] leading-[30px] text-neutral-500">{post.frontmatter.subtitle}</span>
        ) }
        <h3 class="mt-2 text-[21px] leading-[30px] font-medium text-[#121212]">
          {post.frontmatter.title}
        </h3>
        <div class="mt-4 text-[10.8px] text-neutral-500 tracking-[1.20px] leading-[18px]">
          <time>{new Date(post.frontmatter.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time> — <span class="text-[#121212]">{post.frontmatter.readTime}</span>
        </div>
      </article>
    ))}
  </div>
</section>
