---
const allPosts = await Astro.glob('../posts/*.md');
// Filter posts for "Reaching Customers" category
const sectionPosts = allPosts
  .filter(p => p.frontmatter.category === 'Reaching Customers')
  .sort((a, b) => new Date(b.frontmatter.publishDate) - new Date(a.frontmatter.publishDate))
  .slice(0, 4);
---
<section class="w-full max-w-[1200px] mx-auto py-16">
  <!-- Header -->
  <hr class="mb-5 border-[#d9d9d9]" />
  <div class="flex items-center mb-8">
    <div class="w-3 h-3 bg-[#006aff] rounded-sm"></div>
    <span class="ml-[18px] font-medium text-[11.5px] tracking-[1.80px] leading-[22px]">REACHING CUSTOMERS</span>
    <a href="/category/reaching-customers" class="ml-[12px] font-medium text-xs text-[#006aff] tracking-[1.80px] leading-[22px]">VIEW ALL</a>
  </div>

  <!-- Description -->
  <p class="max-w-[584px] mx-auto text-center text-[19.1px] leading-8 mb-16">
    Discover the resources and inspiration you need to reach new<br />customers, wherever they are. Whether it’s building an online<br />store, adding new payment channels, or starting a loyalty program.
  </p>

  <!-- Articles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-10">
    {sectionPosts.map(post => (
      <article key={post.url} class="mb-8">
        <a href={post.url} class="block">
          <img src={post.frontmatter.image} alt={post.frontmatter.title} class="w-full rounded-2xl mb-4 object-cover" style="height: 268px;" />
          <span class="inline-block bg-[#c9e8f5] text-[#121212] rounded px-2 py-1 text-[10.7px] tracking-[1.20px] font-medium mb-3">
            {post.frontmatter.category}
          </span>
          <h3 class="font-medium text-[20.8px] leading-[30px] text-[#121212] mb-2">
            {post.frontmatter.title}
          </h3>
        </a>
        <div class="text-[10.7px] tracking-[1.20px] leading-[18px]">
          <time class="font-medium text-neutral-500">
            {new Date(post.frontmatter.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          {' — '}
          <span class="text-[#121212]">{post.frontmatter.readTime}</span>
        </div>
      </article>
    ))}
  </div>
</section>
